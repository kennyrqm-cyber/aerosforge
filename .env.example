# Application/runtime PostgreSQL URL. On serverless hosting this may be pooled.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aerosforge"
# Optional direct PostgreSQL URL for Prisma migrations. If omitted,
# DATABASE_URL_UNPOOLED (Vercel Neon) or DATABASE_URL is used.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aerosforge"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/aerosforge"
# High-entropy secret, at least 32 characters. Never commit the real value.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# Comma-separated allowlist used by Better Auth dynamic base URL resolution.
# Keep this narrower than *.vercel.app; add the exact project pattern and final custom domain.
# Local/custom hosts only. Vercel's exact deployment and branch hosts are added automatically.
BETTER_AUTH_ALLOWED_HOSTS="localhost:3000,127.0.0.1:3000"
# Fail-closed launch flags. Deliberately enable only in reviewed environments.
PUBLIC_SIGNUP_ENABLED="false"
WINCHESTER_LEADS_ENABLED="false"
CHECKRIDE_LEADS_ENABLED="false"
PUBLIC_INDEXING_ENABLED="false"
# CI-only synthetic identities. The seed rejects this flag outside GitHub Actions.
E2E_TEST_IDENTITIES_ENABLED="false"
E2E_TEST_PASSWORD=""
# Keep false until Resend and the sending domain are both verified.
AUTH_EMAIL_DELIVERY_ENABLED="false"
RESEND_API_KEY=""
AUTH_EMAIL_FROM="AEROSFORGE ONE <accounts@example.com>"
