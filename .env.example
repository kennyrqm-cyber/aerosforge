# Public Supabase settings. Browser RLS remains an authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only OpenAI settings. Never prefix these with NEXT_PUBLIC_ or commit values.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Realtime requires BOTH flags and authenticated users. Keep false until browser/cost testing passes.
AEROCOMM_ENABLE_REALTIME=false
NEXT_PUBLIC_AEROCOMM_REALTIME=false

# Server-only certificate integrity key. Use >=32 random characters.
# This proves AeroComm-issued payload integrity only; it does not imply FAA approval.
AEROCOMM_CERTIFICATE_SIGNING_SECRET=
