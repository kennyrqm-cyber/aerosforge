{
  "name": "aerosforge-one",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "verify": "npm run prisma:generate && npm run typecheck && npm run lint && npm run build",
    "release:gates": "node scripts/check-release-gates.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "security:static": "node scripts/static-security-check.mjs",
    "smoke:postdeploy": "node scripts/postdeploy-smoke.mjs",
    "test:content-workflow": "tsx scripts/content-workflow-integration.ts",
    "test:checkride-leads": "tsx scripts/checkride-lead-integration.ts",
    "test:checkride-baseline": "tsx scripts/checkride-baseline-integration.ts",
    "test:checkride-payments": "tsx scripts/checkride-payment-integration.ts",
    "test:checkride-enrollments": "tsx scripts/checkride-enrollment-integration.ts",
    "test:launch-readiness": "tsx scripts/launch-readiness-integration.ts",
    "test:privacy-requests": "tsx scripts/privacy-request-integration.ts",
    "preflight": "npm run security:static && npm run schema:static && npm run release:gates",
    "role:set": "tsx scripts/set-user-role.ts",
    "schema:static": "node scripts/schema-static-check.mjs",
    "legacy:preserve": "bash scripts/preserve-legacy.sh",
    "legacy:verify": "node scripts/verify-legacy.mjs",
    "legacy:rollback": "bash scripts/rollback-to-legacy.sh"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.3",
    "dotenv": "^17.2.2",
    "next": "16.3.4",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.0",
    "stripe": "22.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  },
  "type": "module"
}
